from pathlib import Path
import os
import sys

# Paths come from chapter_paths.py (single source of truth shared with the
# step scripts); config.yaml only carries tunable parameters. Override the data
# root with `snakemake --config phd_data_root=...` or PHD_DATA_ROOT in the env.
_basedir = Path(workflow.basedir).resolve()
REPO_ROOT = _basedir.parent if _basedir.name == "workflow" else _basedir
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

configfile: str(REPO_ROOT / "workflow" / "config.yaml")

if config.get("phd_data_root"):
    os.environ["PHD_DATA_ROOT"] = str(config["phd_data_root"])

USE_EXTENDED = bool(config.get("use_extended_grid", True))
USE_EXTENDED_FLAG = "1" if USE_EXTENDED else "0"
os.environ["USE_EXTENDED_GRID"] = USE_EXTENDED_FLAG

from chapter_paths import (
    active_grid_gpkg,
    compare_dir,
    coverage_dir,
    extend_dir,
    figure_dir,
    grid100_dir,
    pattern_dir,
    phd_data_root,
    prep_dir,
    waste_id_dir,
)
from lib.arms import ARMS, ARM_KEYS

PHD_DATA = phd_data_root()
FIG = figure_dir()
PREP = prep_dir()
EXT = extend_dir()
COV = coverage_dir()
GRID100 = grid100_dir()
CMP = compare_dir()
PAT = pattern_dir()

ROAD_BUF = int(config.get("road_buffer_m", 50))
SVI_BUF = int(config.get("svi_buffer_m", 50))
INCLUDE_OSMNX = bool(config.get("include_osmnx", True))
ROAD_TAG = f"buf{ROAD_BUF}m"

os.environ["PYTHONPATH"] = str(REPO_ROOT) + (
    os.pathsep + os.environ["PYTHONPATH"] if os.environ.get("PYTHONPATH") else ""
)
# Quadruple-brace PYTHONPATH so Snakemake emits ${PYTHONPATH:-} for bash.
shell.prefix('export PYTHONPATH="' + str(REPO_ROOT) + '":"${{PYTHONPATH:-}}"; ')

wildcard_constraints:
    buffer=r"[0-9]+",
    arm="|".join(ARM_KEYS),


# Steps are added back here as they are rebuilt; each rule file defines
# <STEP>_DATA / <STEP>_FIGS lists that feed the aggregate targets below.
include: "rules/01_prepare.smk"
include: "rules/00_extend_grid.smk"
include: "rules/02_coverage.smk"
include: "rules/03_waste_identification.smk"
include: "rules/04_100m.smk"
include: "rules/05_spatial.smk"

STEP_LISTS = [
    ("PREPARE_DATA", "PREPARE_FIGS", True),
    ("OSMNX_DATA", "OSMNX_FIGS", INCLUDE_OSMNX),
    ("EXTEND_DATA", "EXTEND_FIGS", USE_EXTENDED),
    ("COVERAGE_DATA", "COVERAGE_FIGS", True),
    ("WASTE_ID_DATA", "WASTE_ID_FIGS", True),
    ("GRID100M_DATA", "GRID100M_FIGS", True),
    ("SPATIAL_DATA", "SPATIAL_FIGS", True),
    ("GRID_DATA", "GRID_FIGS", True),
    ("COMPARE_DATA", "COMPARE_FIGS", True),
    ("SPATIAL_DATA", "SPATIAL_FIGS", True),
]


def _collect(which):
    files = []
    for data_name, fig_name, enabled in STEP_LISTS:
        name = data_name if which == "data" else fig_name
        if enabled and name in globals():
            files += list(globals()[name])
    return files


def _all_data():
    return _collect("data")


def _all_figures():
    return _collect("figs")


rule all:
    input:
        _all_data() + _all_figures(),


rule all_data:
    input:
        _all_data(),


rule all_figures:
    input:
        _all_figures(),


rule dag:
    output:
        FIG / "workflow" / "spatial_rulegraph.pdf"
    shell:
        "bash {REPO_ROOT}/workflow/export_dag.sh"
